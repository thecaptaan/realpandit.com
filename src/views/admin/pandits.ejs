<div class="pandit__header row">
    <div>
        <h1>Pandits</h1>
    </div>
    <div class="pandit__search__container">
        <form action="" method="get">
            <div class="input-core">
                <input class="input" type="text" name="search" id="search" placeholder="Search Pandit" required>
            </div>
        </form>
    </div>
</div>
<div class="quick__look__information row">
    <div class="small__card">
        <div class="small__card__header">
            <h3>Total Count</h3>
        </div>
        <div class="small__card__body">
            <p><%= pandits.length %></p>
        </div>
    </div>
    <div class="small__card">
        <div class="small__card__header">
            <h3>Total Count</h3>
        </div>
        <div class="small__card__body">
            <p><%= pandits.length %></p>
        </div>
    </div>
</div>
<div class="data__container"></div>
<div class="page__counter_container row">
    <div>
        <button class="counter__button" id="prevBtn" onclick="prevPage()">Prev</button>
    </div>
    <div class="row">
        <div id="currentPage">1</div>/
        <div id="totalPages">100</div>
    </div>
    <div><button class="counter__button" id="nextBtn" onclick="nextPage()">Next</button></div>
</div>
<script src="https://elasticbeanstalk-ap-south-1-679122753279.s3.ap-south-1.amazonaws.com/toasty.min.js"></script>
<script>
    const pandits = <%- JSON.stringify(pandits) %>;
    console.log(pandits)
    const itemsPerPage = 10;
    const totalPages = Math.ceil(pandits.length / itemsPerPage);
    let currentPage = 1;

    function displayData() {
        const startIndex = (currentPage - 1) * itemsPerPage;
        const endIndex = startIndex + itemsPerPage;
        const currentData = pandits.slice(startIndex, endIndex);

        const dataContainer = document.querySelector('.data__container');
        let userHtml = (user) => `
        <div class="user__card row">
            <div class="user__img__container">
                <img src="https://elasticbeanstalk-ap-south-1-679122753279.s3.ap-south-1.amazonaws.com/${user.profileImg}" alt="" class="user__img">
            </div>
            <div class="user__details__container">
                <h3>
                    ${user.fullName}
                </h3>
                <p>${user.phoneNo}</p>
            </div>
            <div>
                ${user.accountActive === false ?`<p class="red">Suspended</p> ` : '' }
            </div>
            <div class="user__actions__container col">
                <div class="action__option__container">
                    <div class="action__dropdown__item" onclick="()=>{
                        toggleDropdown()
                    }"> Options</div>
                <div class="action__dropdown__content display">
                    ${user.accountActive ?
                        `<form action="/kUXgr2p/users/${user._id}/suspend" class="suspendAccount" method="post">
                            <button type="submit">Suspend</button>
                        </form>`
                            :
                        `<form action="/kUXgr2p/users/${user._id}/unsuspend" class="unSuspendAccount" method="post">
                            <button type="submit">Unsuspend</button>
                        </form>`
                    }
                    <form action="/users/${user._id}/delete" method="post">
                        <button type="submit">Delete</button>
                    </form>
                </div>
            </div>
        </div>
    </div>`
    dataContainer.innerHTML = currentData.map((user) => {
        return userHtml(user)
    }).join('');
    }

    function updatePageInfo() {
        const currentPageElement = document.getElementById('currentPage');
        const totalPagesElement = document.getElementById('totalPages');

        currentPageElement.textContent = currentPage;
        totalPagesElement.textContent = totalPages;
    }

    function nextPage() {
        if (currentPage < totalPages) {
            currentPage++;
            displayData();
            updatePageInfo();
        }
    }

    function prevPage() {
        if (currentPage > 1) {
            currentPage--;
            displayData();
            updatePageInfo();
        }
    }

    displayData();
    updatePageInfo();
</script>
<script>
    let toast = new Toasty();
    let actionDropdown = document.querySelectorAll('.action__dropdown__item');
    let actionDropdownContent = document.querySelectorAll('.action__dropdown__content');
    let suspendAccount = document.querySelectorAll('.suspendAccount');
    let unSuspendAccount = document.querySelectorAll('.unSuspendAccount');
        
    function toggleDropdown(event) {
        const target = event.target;
        console.log(target)
        const dropdownContent = target.nextElementSibling; // Assuming it's a sibling in your structure

        if (target.classList.contains('action__dropdown__item')) {
            dropdownContent.classList.toggle('display');
        }
    }

    // Attach a single event listener to a common parent element
    document.body.addEventListener('click', toggleDropdown);

    for (let i = 0; i < suspendAccount.length; i++) {
        suspendAccount[i].addEventListener('submit', (e) => {
            e.preventDefault();
            let confirmSuspend = confirm('Are you sure you want to suspend this account?');
            if (confirmSuspend) {
                axios.post(suspendAccount[i].action)
                    .then((res) => {
                        if (res.data.success) {
                            window.location.reload();
                        }
                    })
                    .catch((err) => {
                        toast.error(err.response.data.message);
                    })
            }
        })
    }
    for(let i = 0; i < unSuspendAccount.length; i++){
        unSuspendAccount[i].addEventListener('submit', (e) => {
            e.preventDefault();
            let confirmUnsuspend = confirm('Are you sure you want to unsuspend this account?');
            if (confirmUnsuspend) {
                axios.post(unSuspendAccount[i].action)
                    .then((res) => {
                        if (res.data.success) {
                            window.location.reload();
                        }
                    })
                    .catch((err) => {
                        toast.error(err.response.data.message);
                    })
            }
        })
    }

    let activeUsers = pandits.filter((user) => {
        return user.accountActive === true;
    })
    let suspendedUsers = pandits.filter((user) => {
        return user.accountActive === false;
    })
    document.getElementById('activeUsers').textContent = activeUsers.length;
    document.getElementById('suspendedUser').textContent = suspendedUsers.length;
</script>
