<div class="contact-header">
    <h1>Contact</h1>
</div>
<div class="quick__look__information row">
    <div class="small__card">
        <div class="small__card__header">
            <h3>Total User</h3>
        </div>
        <div class="small__card__body">
            <p>
                <%= contact.length %>
            </p>
        </div>
    </div>
    <div class="small__card">
        <div class="small__card__header">
            <h3>Active Contact</h3>
        </div>
        <div class="small__card__body">
            <p id="activeUsers">
                
            </p>
        </div>
    </div>
    <div class="small__card">
        <div class="small__card__header">
            <h3>Completed</h3>
        </div>
        <div class="small__card__body">
            <p id="suspendedUser">
                
            </p>
        </div>
    </div>
</div>
<div class="contact__container"></div>
<div class="page__counter_container row">
    <div>
        <button class="counter__button" id="prevBtn" onclick="prevPage()">Prev</button>
    </div>
    <div class="row">
        <div id="currentPage">1</div>/
        <div id="totalPages">100</div>
    </div>
    <div><button class="counter__button" id="nextBtn" onclick="nextPage()">Next</button></div>
</div>
<style>
    .contact-header {
        margin: 20px 0;
    }

    .contact-header h1 {
        font-size: 2rem;
        font-weight: 600;
    }
    .quick__look__information {
        width: 100%;
        height: fit-content;
        justify-content: space-between;
    }

    .small__card {
        width: 200px;
        height: 100px;
        border-radius: 5px;
        box-shadow: 0 0 5px rgba(0, 0, 0, 0.2);
    }

    .small__card__header {
        width: 100%;
        height: 50%;
        display: flex;
        justify-content: center;
        align-items: center;
        background-color: #f1f1f1;
    }

    .small__card__body {
        width: 100%;
        height: 50%;
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .contact__container {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        align-items: center;
        margin: 20px 0;
    }

    .contact__card {
        width: 100%;
        height: 150px;
        margin: 10px;
        padding: 10px;
        border: 1px solid #ccc;
        border-radius: 5px;
        text-decoration: none;
        color: #000;
    }

    .contact__card__name {
        font-size: 1rem;
        font-weight: 600;
    }

    .contact__card__email {
        font-size: 0.9rem;
        font-weight: 600;
        color: #000000;
        padding-top: 20px;
    }

    .contact__card__position {
        font-size: 0.7rem;
        font-weight: 600;
        color: gray;
    }

    .contact__card__message {
        overflow: hidden;
        text-overflow: ellipsis;
        font-size: 16px;
    }

    .page__counter_container {
        width: 100%;
        padding: 20px 0;
        align-items: center;
        justify-content: space-around;
    }

    .counter__button {
        width: 100px;
        height: 50px;
        border-radius: 5px;
        border: none;
        cursor: pointer;
        color: #ffffff;
        background-color: var(--light-orange) !important;
    }
</style>
<script>
    const contactData = <%- JSON.stringify(contact) %>;
    const itemsPerPage = 10;
    const totalPages = Math.ceil(contactData.length / itemsPerPage);
    let currentPage = 1;

    function displayData() {
        const startIndex = (currentPage - 1) * itemsPerPage;
        const endIndex = startIndex + itemsPerPage;
        const currentData = contactData.slice(startIndex, endIndex);

        const dataContainer = document.querySelector('.contact__container');
        let userHtml = (contact) => `
        <a href="/contact/${contact._id}" class="contact__card">
            <div class="contact__card__name">
                <h3>${contact.fullName}</h3>
            </div>
            <div class="contact__card__email">
                <p>${contact.email}</p>
            </div>
            <div class="contact__card__position">
                <p>${contact.position}</p>
            </div>
            <div class="contact__card__message">
                <p>${contact.message}</p>
            </div>
        </a>`
    dataContainer.innerHTML = currentData.map((contact) => {
        return userHtml(contact)
    }).join('');
    }

    function updatePageInfo() {
        const currentPageElement = document.getElementById('currentPage');
        const totalPagesElement = document.getElementById('totalPages');

        currentPageElement.textContent = currentPage;
        totalPagesElement.textContent = totalPages;
    }

    function nextPage() {
        if (currentPage < totalPages) {
            currentPage++;
            displayData();
            updatePageInfo();
        }
    }

    function prevPage() {
        if (currentPage > 1) {
            currentPage--;
            displayData();
            updatePageInfo();
        }
    }

    displayData();
    updatePageInfo();
</script>