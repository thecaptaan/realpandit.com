<%- include('layouts/NavLayout') %>

    <div class="team__container cent">
        <div class="team__header col">
            <h1>Our Team</h1>
        </div>
    </div>
    <div class="team__card__container cent">
        <div class="team__card">
            <div class="team__card__img__container cent">
                <img class="team__card__img" src="https://elasticbeanstalk-ap-south-1-679122753279.s3.ap-south-1.amazonaws.com/Vaibhav _Singh _Rathore.jpeg" alt="">
            </div>
            <div class="team__card__info">
                <h3>Vaibhav Singh Rathore</h3>
                <p>CEO</p>
            </div>
        </div>
        <div class="team__card">
            <div class="team__card__img__container cent">
                <img class="team__card__img" src="https://elasticbeanstalk-ap-south-1-679122753279.s3.ap-south-1.amazonaws.com/yash_sharma.jpeg" alt="">
            </div>
            <div class="team__card__info">
                <h3>Yash Sharma</h3>
                <p>Developer</p>
            </div>
        </div>
        <div class="team__card">
            <div class="team__card__img__container cent">
                <img class="team__card__img" src="https://elasticbeanstalk-ap-south-1-679122753279.s3.ap-south-1.amazonaws.com/Mohit_gamnani.jpeg" alt="">
            </div>
            <div class="team__card__info">
                <h3>Mohit Gamnani</h3>
                <p>Content Creator</p>
            </div>
        </div>
    </div>
    <style>

        .team__container {
            height: fit-content;
            width: 100%;
            padding: 50px 0;
        }
        .team__container h1 {
            margin: 0;
            font-size: 2rem;
            color: var(--light-orange);
        }
        .team__card__container {
            height: calc(100vh - 200px);
            flex-wrap: wrap;
            padding: 0 50px;
            justify-content: space-between;
        }

        .team__card {
            width: 300px;
            height: fit-content;
            overflow: hidden;
            margin: 20px 0;
            border: 1px solid var(--light-orange);
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
        }

        .team__card__img__container {
            width: 300px;
            height: 300px;
            overflow: hidden;
        }

        .team__card__img {
            width: 90%;
            height: 90%;
            object-fit: cover;
        }

        .team__card__info {
            padding: 20px;
        }

        .team__card__info h3 {
            margin: 0;
            font-size: 1.2rem;
        }

        .team__card__info p {
            margin: 0;
            font-size: 1rem;
            color: #777;
            text-transform: lowercase;
        }
    </style>
<%- include('layouts/FooterLayout') %>