<link rel="stylesheet" href="https://elasticbeanstalk-ap-south-1-679122753279.s3.ap-south-1.amazonaws.com/realpandit/styles/index.css" />
<!--  -->
<%- include('layouts/NavLayout') %>

<!--  -->
<div class="index-banner">
  <img class="banner-img" src="https://elasticbeanstalk-ap-south-1-679122753279.s3.ap-south-1.amazonaws.com/realpandit/images/city.png" alt="" />
  <div class="banner-cover cent">
    <div class="banner-main-container col cent">
      <h1 class="landing-text">
        Book Trusted Pandits for Your Sacred Ceremonies
      </h1>
      <div class="banner-search-form-container">
        <form action="" method="get">
          <div class="banner-search row cent">
            <div class="banner-input-1 row">
              <input
                class="input-search"
                type="text"
                placeholder="Enter Your City"
                required
              />
              <img class="input-svg" src="https://elasticbeanstalk-ap-south-1-679122753279.s3.ap-south-1.amazonaws.com/realpandit/images/location.svg" alt="" />
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<!--  -->
<div class="featured-pandit">
  <div class="featured-header">
    <h1>Featured Pandits</h1>
  </div>
  <div class="pandit-card-container row">
    <% panditData.forEach((pandit) => { %>
    <div class="pandit-card">
      <div class="pandit-card-img cent">
        <img src="/<%= pandit.image %>" alt="" />
      </div>
      <div class="pandit-card-info">
        <div class="pandit-card-name">
          <h3><%= pandit.name %></h3>
        </div>
      </div>
    </div>
    <% }) %>
  </div>
</div>
    <!--  -->
    <div class="aarti-container">
      <video src="https://elasticbeanstalk-ap-south-1-679122753279.s3.ap-south-1.amazonaws.com/realpandit/videos/aarti.mp4" class="aarti-video" autoplay loop muted>
        video is not supported
      </video>
      <div class="aarti-main cent">
        <div class="col">
          <div class="cent">
            <h1>Join As A Pandit</h1>
          </div>
          <div>
            <button class="button">Log In</button>
            <button class="button">Sign Up</button>
          </div>
        </div>
      </div>
    </div>

    <!--  -->
    <%- include('layouts/FooterLayout') %>
  </div>
</div>
