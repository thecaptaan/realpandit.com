    <script src="https://inorganik.github.io/countUp.js/dist/countUp.umd.js"></script>
    <script>
      function counter(id, no) {
        const options = {
          suffix: '+',
        };
        let counter = new countUp.CountUp(id, no, options);
        if (!counter.error) {
          counter.start();
        } else {
          let counterId = document.getElementById(id).innerText = no;
        }
      }
      counter('panditCounter', 50);
      counter('citiesCounter', 4);
      counter('userCounter', 1000);
    </script>
    <script type="module">

