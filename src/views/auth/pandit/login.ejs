<link rel="stylesheet" href="https://elasticbeanstalk-ap-south-1-679122753279.s3.ap-south-1.amazonaws.com/auth.css" />
<link rel="stylesheet" href="https://elasticbeanstalk-ap-south-1-679122753279.s3.ap-south-1.amazonaws.com/pandit.css" />
<link rel="stylesheet" href="https://elasticbeanstalk-ap-south-1-679122753279.s3.ap-south-1.amazonaws.com/toasty.min.css">
<div class="auth-container row">
  <div class="auth-item people-form-container cent">
    <form action="" class="" id="panditLogin">
      <div class="auth-header">
        <h1>Log In</h1>
      </div>
      <input type="hidden" name="g-recaptcha-response" id="g-recaptcha-response" required />
      <div class="input-core">
        <input type="text" id="phoneNo" class="input" placeholder="Mobile Number" required />
      </div>
      <div class="input-core">
        <input type="password" id="password" class="input" placeholder="Password" required />
      </div>
      <button class="button">Log In</button>
      <div class="auth-footer">
        <p>Create a account <a href="/user/pandit/signup">Sign Up</a></p>
      </div>
    </form>
  </div>
  <div class="auth-item auth-pandit-img-cont">
    <img class="auth-pandit-img" src="https://elasticbeanstalk-ap-south-1-679122753279.s3.ap-south-1.amazonaws.com/ganesh.jpg" alt="" />
  </div>
</div>
<%- include('../../layouts/FooterLayout') %>
